<section class="admin-page narrow-admin-page">
  <%= render "admin/navigation" %>
  <%= link_to "← リソース管理へ", admin_resources_path, class: "back-link" %>
  <header class="review-header">
    <div class="card-meta"><span class="kind-badge"><%= resource_kind_label(@revision.resource) %></span><span class="status status-<%= @revision.review_status %>"><%= @revision.review_status %></span><span>AI: <%= @revision.summary_status %></span></div>
    <h1><%= @revision.title %></h1>
    <p><%= link_to @revision.resource.canonical_url, @revision.resource.canonical_url, target: "_blank", rel: "noopener noreferrer" %></p>
  </header>

  <div class="review-grid">
    <section class="admin-panel"><p class="eyebrow">SOURCE EXCERPT</p><h2>要約根拠</h2><div class="source-excerpt"><%= simple_format(@revision.source_excerpt) %></div></section>
    <section class="admin-panel"><p class="eyebrow">AI SUMMARY</p><h2>公開候補の要約</h2><div class="source-excerpt"><%= simple_format(@revision.ai_summary) %></div></section>
  </div>

  <div class="review-actions">
    <%= link_to "候補を編集", edit_admin_resource_revision_path(@revision), class: "button button-secondary" %>
    <% unless @revision.approved? %><%= button_to "承認して公開", approve_and_publish_admin_resource_revision_path(@revision), method: :post, class: "button button-primary" %><% end %>
  </div>
</section>
