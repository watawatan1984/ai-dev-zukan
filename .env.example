# Rails / public URL (optional on Render; defaults to RENDER_EXTERNAL_HOSTNAME)
APP_HOST=aidevzukan.example.com
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/ai_dev_zukan_production
QUEUE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/ai_dev_zukan_queue
SOLID_QUEUE_IN_PUMA=1

# Authentication and email
MAILER_FROM="AI開発図鑑 <noreply@example.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=

# AI (model is intentionally selected outside this repository)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Source APIs
GITHUB_TOKEN=
GITHUB_README_FETCH_LIMIT=10
QIITA_ACCESS_TOKEN=
QIITA_IMPORT_QUERY=stocks:>=10
ZENN_FEED_URLS=
SOURCE_IMPORT_LIMIT=10

# One-time initial catalog bootstrap
BOOTSTRAP_PER_KIND=100
BOOTSTRAP_AI_CONCURRENCY=3
BOOTSTRAP_NVIDIA_MODEL=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# GAS signed scheduler
GAS_SCHEDULER_SECRET=
